# 이 파일에는 실제 키를 넣지 않는다.
#   cp .env.sample .env    (또는 make env)
# 를 하고 .env 쪽을 채운다. .env는 gitignore 되어 커밋되지 않는다.
#
# 값이 비어 있는 것은 시크릿이다. 기본값을 주지 않는다 —
# 없으면 뜨는 순간 죽는 게 낫다(docs/development-rules.md 6.3).

# LLM — 셋 중 하나만 채우면 된다
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 채운 키에 맞춰 바꾼다. litellm 표기를 쓴다.
#   anthropic/claude-sonnet-5 · gemini/gemini-2.5-flash · openai/gpt-4o-mini
AGENT_MODEL=anthropic/claude-sonnet-5

# 공통 — "어제", "이번 달"의 경계를 이 타임존으로 계산한다
USER_TIMEZONE=Asia/Seoul

# DB
POSTGRES_USER=account
POSTGRES_PASSWORD=
POSTGRES_DB=account_book

# 에이전트 하네스
AGENT_MAX_STEPS=8
AGENT_MAX_COST_USD=0.50
AGENT_CONFIRM_THRESHOLD=100000

# 서비스 주소 — compose 내부 네트워크 기준
API_BASE_URL=http://api:8000
AGENT_BASE_URL=http://agent:8001

# ui
UI_PORT=8080
UI_SESSION_SECRET=
