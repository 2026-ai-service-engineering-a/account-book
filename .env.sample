# 이 파일에는 실제 키를 넣지 않는다.
#   cp .env.sample .env    (또는 make env)
# 를 하고 .env 쪽을 채운다. .env는 gitignore 되어 커밋되지 않는다.
#
# 값이 비어 있는 것은 시크릿이다. 기본값을 주지 않는다 —
# 없으면 뜨는 순간 죽는 게 낫다(docs/development-rules.md 6.3).

# LLM — 셋 중 하나만 채우면 된다
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# litellm 표기(<제공자>/<모델>)를 쓴다. 기본값은 가장 싼 축인 Gemini Flash-Lite다.
# 다른 키를 채웠다면 anthropic/<모델> · openai/<모델> 형태로 바꾼다.
AGENT_MODEL=gemini/gemini-flash-lite-latest

# 공통 — "어제", "이번 달"의 경계를 이 타임존으로 계산한다
USER_TIMEZONE=Asia/Seoul

# DB — PostgreSQL + pgvector. api만 붙는다(README 3장).
POSTGRES_USER=account
POSTGRES_PASSWORD=
POSTGRES_DB=account_book
# api가 붙는 DB 주소 — compose 내부 네트워크 기준
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 에이전트 하네스
AGENT_MAX_STEPS=8
AGENT_MAX_COST_USD=0.50
AGENT_CONFIRM_THRESHOLD=100000
# LLM 호출 한 번의 상한(초). 스키마를 못 맞추면 한 번 더 부르므로 요청 하나는 두 배까지 간다.
AGENT_TIMEOUT_SECONDS=10

# 카테고리 고르기(RAG) — docs/ai/category-suggestion-rag.md
# 임베딩 모델(litellm 표기). 비우면 벡터 검색을 끈다 — 규칙·이력으로만 고르고 나머지는 사람이 고른다.
EMBEDDING_MODEL=gemini/gemini-embedding-001
# pgvector HNSW 인덱스의 2000차원 상한 아래로 받아 둔다
EMBEDDING_DIMENSIONS=768
# 이웃 몇 건으로 투표하나, 그리고 가장 비슷한 이웃 쪽으로 얼마나 기울이나(낮을수록 기운다)
RAG_TOP_K=8
RAG_VOTE_TEMPERATURE=0.03
# 벡터 단계 1위 신뢰도가 이 이상이면 LLM 없이 쓰고, ABSTAIN 아래면 사람에게 넘긴다. 사이는 LLM.
CLASSIFY_MIN_CONFIDENCE=0.7
CLASSIFY_ABSTAIN_BELOW=0.25

# 서비스 주소 — compose 내부 네트워크 기준
# api는 아직 없다. compose가 agent에게는 ui 안의 api 대역(http://ui:8080)을 대신 넘긴다.
API_BASE_URL=http://api:8000
# 비우면 ui의 AI 자리에 각본 대역이 선다 — 키 없이 화면을 만져 볼 때
AGENT_BASE_URL=http://agent:8001

# ui
UI_PORT=8080
UI_SESSION_SECRET=
